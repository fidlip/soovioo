# System files
.DS_Store
Thumbs.db
# Claude Code session-local state (root level only; frontend/.claude is intentional)
/.claude/

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# .NET backend
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/.vs/
# Uploaded message/homework attachments (local disk storage, see
# MessageAttachmentStorageService) — user content, never committed.
backend/**/AttachmentStorage/

# Node / Nx frontend (also covered by frontend/.gitignore, kept here for repo-wide tooling)
**/node_modules/
**/dist/
**/.nx/cache/
**/.nx/workspace-data/
**/.angular/
**/*.log

.nx/polygraph

# Author's local notes — not published
IDEAS.md
ROADMAP.md

# Production secrets (deploy/.env.example is the template)
deploy/.env
