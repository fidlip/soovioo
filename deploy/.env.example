# Copy to .env (never committed) and fill in. Generate secrets with:
#   openssl rand -hex 32
# (hex on purpose: it goes into a connection string unescaped)

# Where the app runs: schools at <slug>.MAIN_DOMAIN. Must match
# environment.prod.ts mainDomain in the web app (baked into its build).
MAIN_DOMAIN=soovioo.cloud
# Cloudflare API token for the wildcard certificate (DNS-01): permission
# Zone · DNS · Edit for the MAIN_DOMAIN zone only, IP-filtered to the VPS.
CLOUDFLARE_API_TOKEN=
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# First password of the built-in "superadmin" account — used only on the
# very first start (empty database); changing it is forced at first login.
# You can delete it from .env after that.
SUPERADMIN_PASSWORD=

# Outgoing mail (invite e-mails): the Forpsi mailbox noreply@soovioo.cz.
# Port 587 with STARTTLS — .NET's SmtpClient can't do implicit TLS (465).
# The sender must be on soovioo.cz: its SPF allows Forpsi, and DMARC
# (p=quarantine) would junk any other From domain.
SMTP_HOST=smtp.forpsi.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=noreply@soovioo.cz
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@soovioo.cz
