# Copy to .env (never committed) and fill in. Generate secrets with:
#   openssl rand -hex 32
# (hex on purpose: it goes into a connection string unescaped)

# Where the app runs: schools at <slug>.MAIN_DOMAIN. Must match
# environment.prod.ts mainDomain in the web app (baked into its build).
MAIN_DOMAIN=soovioo.cloud
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# First password of the built-in "superadmin" account — used only on the
# very first start (empty database); changing it is forced at first login.
# You can delete it from .env after that.
SUPERADMIN_PASSWORD=

# Outgoing mail (invite e-mails). Provider not chosen yet — without it,
# sending invites fails.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@soovioo.cloud
