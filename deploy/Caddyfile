# Reverse proxy + TLS + static web app. Domains come from deploy/.env.
{
	# No ACME e-mail: Let's Encrypt no longer sends expiry notices and
	# Caddy renews on its own.
	# School subdomains get their certificate on first visit — no wildcard
	# certificate, so no DNS-provider API is needed. The backend confirms
	# the subdomain belongs to an existing school (Hosting/TlsAskController).
	on_demand_tls {
		ask http://api:8080/api/tls/ask
	}
}

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Internal to the Docker network only (Caddy's own TLS check).
	handle /api/tls/* {
		respond 404
	}

	# Same origin as the web app (environment.production in app.config.ts),
	# so no CORS and the SameSite=Strict auth cookies just work.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/app
		# Angular's content-hashed bundles (main-5OZKOP7X.js) never change;
		# everything else, index.html above all, must be revalidated so a
		# new deploy is picked up.
		@hashed path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Bare main domain: no school — landing/SuperAdmin area.
{$MAIN_DOMAIN} {
	import app
}

# <slug>.{$MAIN_DOMAIN}: a school.
*.{$MAIN_DOMAIN} {
	tls {
		on_demand
	}
	import app
}
