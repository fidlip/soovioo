# Reverse proxy + TLS + static web app. Domains come from deploy/.env.
{
	# No ACME e-mail: Let's Encrypt no longer sends expiry notices and
	# Caddy renews on its own.
}

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Search engines index only the public site (www.soovioo.cz); the
		# app, school subdomains and the demo stay out. robots.txt keeps
		# allowing crawling, otherwise this header would never be seen.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Same origin as the web app (environment.production in app.config.ts),
	# so no CORS and the SameSite=Strict auth cookies just work.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/app
		# Angular's content-hashed bundles (main-5OZKOP7X.js) never change;
		# everything else, index.html above all, must be revalidated so a
		# new deploy is picked up.
		@hashed path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Bare main domain: no school — landing/SuperAdmin area.
# <slug>.{$MAIN_DOMAIN}: a school (an unknown slug gets the SPA's "school
# doesn't exist" page). One wildcard certificate covers every school, issued
# through a DNS-01 challenge in the Cloudflare zone — so a new school works
# right away and the Let's Encrypt rate limit (50 new certificates a week per
# domain) doesn't apply. The token may only edit DNS of this one zone.
{$MAIN_DOMAIN}, *.{$MAIN_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	import app
}
