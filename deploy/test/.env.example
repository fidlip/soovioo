# Copy to /opt/soovioo-test/.env (never committed) and fill in. Secrets of
# their own, never production's: openssl rand -hex 32

MAIN_DOMAIN=test.soovioo.cloud
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
# First password of the built-in "superadmin" (empty database only).
SUPERADMIN_PASSWORD=
# Login to Mailpit's web UI (https://test.soovioo.cloud/mailpit/), as
# "user:password".
MAILPIT_UI_AUTH=
# The test backoffice (soovioo-backoffice, deploy/test). Empty = not connected.
BACKOFFICE_BASE_URL=
BACKOFFICE_INSTANCE_ID=
# The same value as CLOUD_INSTANCE_SECRET of the test backoffice.
BACKOFFICE_SECRET=
