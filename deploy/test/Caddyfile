# The test instance's web: plain HTTP behind production's Caddy, which
# terminates TLS and adds the security headers (deploy/Caddyfile).
{
	auto_https off
	admin off
	servers {
		# Production's Caddy: the client's address and scheme come from it.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Mailpit, on the bare test domain only (*.MAIN_DOMAIN are schools).
	@mailpit {
		host {$MAIN_DOMAIN}
		path /mailpit /mailpit/*
	}
	handle @mailpit {
		reverse_proxy mailpit:8025
	}

	handle /api/* {
		reverse_proxy api:8080 {
			# The client alone, as production's API gets it — not followed
			# by production's Caddy.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# As in deploy/Caddyfile.
	handle {
		root * /srv/app
		@hashed path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		templates {
			mime text/html
		}
		# version.json's "version" is the release's APP_VERSION when there is one.
		@version path /version.json
		templates @version {
			mime application/json
		}
		file_server
	}
}
