{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@soovioo/shared": ["./libs/shared/src/index.ts"],
      "@fidlip/soovioo-ui": ["./libs/ui/src/index.ts"],
      "@fidlip/soovioo-ui/format": ["./libs/ui/format/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
